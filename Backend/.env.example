# Your BODS API key — register free at https://data.bus-data.dft.gov.uk/account/signup/
BODS_API_KEY=paste-your-key-here

# GTFS timetable region to import. Options include:
#   all, london, south_east, south_west, east_anglia, east_midlands,
#   west_midlands, yorkshire, north_east, north_west, wales, scotland
# Start with one region — "all" is a very large download.
GTFS_REGION=north_west

# Route map lines (shapes) are the second-biggest chunk of the national
# dataset. Set to false to roughly halve disk needs for GTFS_REGION=all —
# route detail screens just won't draw the line on the map.
GTFS_IMPORT_SHAPES=true

# How often to poll the live vehicle feed (seconds). BODS updates ~every 10s.
POLL_SECONDS=10

# HTTP port
PORT=3000

# --- Production hardening (optional in development) ---
# Set to "production" when deployed: hides internal error detail from clients.
NODE_ENV=development

# Requests allowed per IP per minute before rate limiting kicks in.
RATE_LIMIT_PER_MINUTE=120

# Optional shared secret. When set, clients must send a matching x-app-token
# header (the iOS app sends it in release builds). Leave blank for local dev.
APP_SHARED_TOKEN=

# --- Push notifications (APNs) ---
# From the Apple Developer account. Server push stays off until these are set.
# 1. Create a Key with "Apple Push Notifications service" enabled -> .p8 file.
# 2. Upload the .p8 to the server and point APNS_KEY_PATH at it.
APNS_KEY_PATH=./apns-key.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.bricksinabag.buspulse
# false = sandbox (Xcode/TestFlight device builds); true = App Store builds.
APNS_PRODUCTION=false

# Protects /admin endpoints (e.g. the test push). Set to a long random string.
ADMIN_KEY=

# --- Journey planner tuning (optional; sensible defaults) ---
# How far ahead the first bus of a one-change journey may depart (minutes).
JOURNEY_LEG1_WINDOW_MINUTES=75
# Minimum time to change buses, before any walking (seconds).
JOURNEY_TRANSFER_BUFFER_SECONDS=180
# Longest walk between two stops when changing buses (metres).
JOURNEY_MAX_TRANSFER_WALK_METERS=400
