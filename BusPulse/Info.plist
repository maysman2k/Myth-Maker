<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Wait Less</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wait Less uses your location to find bus stops near you and centre the live map.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Development only: allow plain HTTP to the local BODS proxy on
		     localhost. The production server uses HTTPS, so this exception
		     has no effect on release builds. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bricksinabag.buspulse</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>waitless</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Names Siri will accept for App Shortcut phrases, so mis-hearings of
	     "Wait Less" (commonly heard as "Wallace") still trigger our intent.
	     iOS enforces a hard maximum of THREE entries — a fourth makes the
	     app refuse to install ("Unable to Install"). -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Waitless</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Wallace</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Bus Pulse</string>
		</dict>
	</array>
</dict>
</plist>
